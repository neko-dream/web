{
  "name": "kotohiro-app",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "test": "node --import ./tests/register.ts --test tests/*.test.ts",
    "generate:api": "node tools/generate.ts",
    "dev": "react-router dev",
    "dev:local": "cross-env LOCAL_API_URL=http://127.0.0.1:8080 react-router dev",
    "build": "react-router build",
    "deploy": "wrangler deploy --env develop",
    "format": "biome format --write ./app",
    "lint": "biome check .",
    "typecheck": "react-router typegen && tsc",
    "test:auth": "node --experimental-strip-types --test tests/email-login.test.ts tests/build-environment.test.ts",
    "icongen": "svgr --out-dir app/components/Icons -- app/assets/icons && biome format --write ./app/components/Icons"
  },
  "dependencies": {
    "@conform-to/react": "^1.21.3",
    "@conform-to/valibot": "^1.21.3",
    "@react-router/fs-routes": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-code": "^3.33.1",
    "@tiptap/extension-document": "^3.33.1",
    "@tiptap/extension-dropcursor": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-paragraph": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-text": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "chart.js": "^4.6.1",
    "compressorjs": "^1.4.0",
    "dayjs": "^1.11.23",
    "gsap": "^3.15.1",
    "isbot": "^5.2.3",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "react-toastify": "^11.2.0",
    "simplebar-react": "^3.3.2",
    "swiper": "^14.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2",
    "tiptap-extension-resize-image": "^1.4.7",
    "valibot": "^1.5.0",
    "xss": "^1.0.17",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@react-router/dev": "^8.5.1",
    "@svgr/cli": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "cross-env": "^10.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.160.1"
  },
  "svgr": {
    "plugins": [
      "@svgr/plugin-svgo",
      "@svgr/plugin-jsx"
    ],
    "jsxRuntime": "automatic",
    "noDimensions": true,
    "typescript": true,
    "prettier": false,
    "svgoConfig": {
      "plugins": [
        {
          "name": "preset-default",
          "params": {
            "overrides": {
              "removeViewBox": false,
              "cleanupIds": {
                "remove": true,
                "minify": false
              }
            }
          }
        }
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "js-yaml@<4.2.0": ">=4.2.0",
      "esbuild@<0.28.1": ">=0.28.1"
    }
  }
}
