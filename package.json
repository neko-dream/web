{
  "name": "kotohiro-app",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "test": "node --import ./tests/register.ts --test tests/*.test.ts",
    "generate:api": "node tools/generate.ts",
    "dev": "react-router dev",
    "dev:local": "cross-env LOCAL_API_URL=http://127.0.0.1:8080 react-router dev",
    "build": "react-router build",
    "deploy": "wrangler deploy --env develop",
    "format": "biome format --write ./app",
    "lint": "biome check .",
    "typecheck": "react-router typegen && wrangler types && tsc -b",
    "test:auth": "node --experimental-strip-types --test tests/email-login.test.ts tests/build-environment.test.ts",
    "icongen": "svgr --out-dir app/components/Icons -- app/assets/icons && biome format --write ./app/components/Icons"
  },
  "dependencies": {
    "@conform-to/react": "^1.2.2",
    "@conform-to/valibot": "^1.6.1",
    "@react-router/fs-routes": "~8.3.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.6",
    "@tiptap/core": "^2.11.7",
    "@tiptap/extension-code": "^3.19.0",
    "@tiptap/extension-document": "^3.19.0",
    "@tiptap/extension-dropcursor": "^2.11.7",
    "@tiptap/extension-image": "^2.11.7",
    "@tiptap/extension-link": "^2.11.7",
    "@tiptap/extension-paragraph": "^3.19.0",
    "@tiptap/extension-placeholder": "^2.11.7",
    "@tiptap/extension-text": "^3.19.0",
    "@tiptap/pm": "^2.11.7",
    "@tiptap/react": "^2.11.7",
    "@tiptap/starter-kit": "^2.11.7",
    "chart.js": "^4.4.8",
    "compressorjs": "^1.2.1",
    "dayjs": "^1.11.13",
    "gsap": "^3.13.0",
    "isbot": "^4.1.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.5.0",
    "openapi-fetch": "^0.12.2",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "~8.3.1",
    "react-toastify": "^10.0.6",
    "react-use-gesture": "^9.1.3",
    "simplebar-react": "^3.3.0",
    "swiper": "^12.1.2",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tiptap-extension-resize-image": "^1.2.1",
    "valibot": "~1.4.2",
    "xss": "^1.0.15",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/vite-plugin": "^1.42.3",
    "@cloudflare/workers-types": "^4.20241112.0",
    "@react-router/dev": "~8.3.1",
    "@svgr/cli": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/bun": "^1.1.11",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "cross-env": "^7.0.3",
    "openapi-typescript": "^7.6.1",
    "postcss": "^8.5.31",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "~8.1.6",
    "wrangler": "^4.105.0"
  },
  "svgr": {
    "plugins": ["@svgr/plugin-svgo", "@svgr/plugin-jsx"],
    "jsxRuntime": "automatic",
    "noDimensions": true,
    "typescript": true,
    "prettier": false,
    "svgoConfig": {
      "plugins": [
        {
          "name": "preset-default",
          "params": {
            "overrides": {
              "removeViewBox": false,
              "cleanupIds": {
                "remove": true,
                "minify": false
              }
            }
          }
        }
      ]
    }
  },
  "pnpm": {
    "overrides": {
      "js-yaml@<4.2.0": ">=4.2.0",
      "esbuild@<0.28.1": ">=0.28.1",
      "js-yaml@>=4.2.0 <4.3.2": "^4.3.2",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "linkify-it@<5.0.2": "^5.0.2",
      "markdown-it@>=14.0.0 <14.3.3": "^14.3.3",
      "prosemirror-view@<1.42.3": "^1.42.3",
      "prosemirror-model@<1.25.12": "^1.25.12",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "svgo@>=3.0.0 <3.3.5": "^3.3.5",
      "undici@>=7.0.0 <7.29.1": "^7.29.1"
    }
  }
}
