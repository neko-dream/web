{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/.react-router"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["**/tests/**/*.ts"],
      "linter": {
        "rules": {
          "style": { "noDoneCallback": "off" },
          "suspicious": { "useAwait": "off" }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "includes": [
      "**",
      "!app/components/features/opinion-graph/**",
      "!tools/kotohiro.openapi.yaml",
      "!tools/generate.ts",
      "!app/components/features/date-scroll-picker/**"
    ],
    "rules": {
      "nursery": {
        "useTailwindSortedClasses": "off"
      },
      "suspicious": {
        "noReactSpecificProps": "off",
        "noEmptyBlockStatements": "off",
        "noArrayIndexKey": "off",
        "useErrorMessage": "off"
      },
      "style": {
        "useNamingConvention": "off",
        "noDefaultExport": "off",
        "useFilenamingConvention": "off",
        "noParameterAssign": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "correctness": {
        "useImportExtensions": "off",
        "noUndeclaredDependencies": "off",
        "noUndeclaredVariables": "off",
        "useExhaustiveDependencies": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off"
      }
    }
  },
  "tailwind": { "variantFunctions": ["tv"] }
}
